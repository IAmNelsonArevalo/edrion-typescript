{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true,
        "paths": {
            "@nest": ["./src/index.ts"],
            "@nest/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "tsup.config.ts"],
    "exclude": ["dist", "node_modules", "coverage"]
}
