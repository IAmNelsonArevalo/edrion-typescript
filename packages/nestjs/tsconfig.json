{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "paths": {
            "@nest": ["./src/index.ts"],
            "@nest/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "node_modules", "test"]
}
