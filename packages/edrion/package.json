{
    "name": "edrion-typescript",
    "version": "0.6.0",
    "description": "TypeScript AI and Deep Learning framework for the Edrion ecosystem",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@edrion/core": "workspace:*",
        "@edrion/nestjs": "workspace:*"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc -p tsconfig.build.json --noEmit",
        "lint": "eslint src",
        "clean": "rm -rf dist"
    }
}
