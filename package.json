{
    "name": "edrion-typescript-monorepo",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@10",
    "scripts": {
        "clean": "pnpm -r --if-present clean",
        "build:core": "pnpm --filter @edrion/core build",
        "build:nestjs": "pnpm --filter @edrion/nestjs build",
        "build:facade": "pnpm --filter edrion-typescript build",
        "build": "pnpm build:core && pnpm build:nestjs && pnpm build:facade",
        "typecheck:core": "pnpm --filter @edrion/core typecheck",
        "typecheck:nestjs": "pnpm build:core && pnpm --filter @edrion/nestjs typecheck",
        "typecheck:facade": "pnpm build:core && pnpm build:nestjs && pnpm --filter edrion-typescript typecheck",
        "typecheck": "pnpm typecheck:core && pnpm typecheck:nestjs && pnpm typecheck:facade",
        "typecheck:test": "pnpm build:core && pnpm --filter @edrion/core typecheck:test && pnpm --filter @edrion/nestjs typecheck:test",
        "test:core": "pnpm --filter @edrion/core test",
        "test:nestjs": "pnpm build:core && pnpm --filter @edrion/nestjs test",
        "test": "pnpm test:core && pnpm test:nestjs",
        "lint": "pnpm -r --if-present lint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm format:check && pnpm typecheck && pnpm typecheck:test && pnpm lint && pnpm test && pnpm build"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.0.0",
        "prettier": "^3.0.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0",
        "tsup": "^8.0.0",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.0.0",
        "vitest": "^3.2.0"
    }
}
